<section id="privacy-panel" class="privacy-panel" role="dialog" aria-modal="true" aria-labelledby="privacy-title" hidden>
    <div><h2 id="privacy-title" tabindex="-1">Your privacy</h2><p>Cloudflare analytics is optional. Request limits work with either choice. Rejecting keeps all features. <a href="/privacy">Privacy policy</a></p><p id="privacy-feedback" role="status"></p></div>
    <div class="privacy-actions"><button type="button" id="privacy-reject" aria-label="Reject analytics">Reject</button><button type="button" id="privacy-accept" aria-label="Allow analytics">Allow</button><button type="button" id="privacy-close" aria-label="Close privacy notice">Not now</button></div>
</section>
