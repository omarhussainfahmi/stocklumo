<div class="search">
    <label for="search">Find a stock</label>
    <input id="search" type="search" maxlength="60" placeholder="Search a company or ticker symbol" autocomplete="off" aria-controls="search-results" />
    <p id="search-status" role="status"></p>
    <ul id="search-results" aria-label="Search results" hidden></ul>
</div>
