@{ var onStock = !string.IsNullOrEmpty(ViewData["Symbol"] as string); }
<section id="watch-section" class="section watch-panel">
    <div class="section-title"><h2>@(Context.Request.Path == "/watchlist" ? "Saved companies" : "Your watchlist")</h2>@if (onStock) { <a class="panel-link" href="/watchlist">View all <span class="direction-icon direction-right" aria-hidden="true"></span></a> }<span id="watch-count">SAVED ON THIS DEVICE</span></div>
    <div id="watch-empty" class="empty-state"><h3>No saved stocks yet</h3><p>Search for a company, then add it to your watchlist.</p><a class="button-link" href="/markets">Explore stocks <span class="direction-icon direction-right" aria-hidden="true"></span></a></div>
    <div id="watch-balance" class="selection-balance" hidden></div>
    <div class="table-wrap"><table id="watch-table" hidden><caption class="sr-only">Saved stocks. Prices and changes come from Finnhub.</caption><thead><tr><th>Company</th><th>Last price</th><th>Day change</th><th>Data age</th><th>Manage</th></tr></thead><tbody id="watch-rows"></tbody></table></div>
    <p id="watch-trend-source" class="caption" hidden></p>
    <p id="storage-status" role="status" class="caption">Saved in this browser.</p>
</section>
