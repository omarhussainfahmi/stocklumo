@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
<header class="header">
    <a class="brand" href="/" aria-label="Stocklumo home"><img asp-append-version="true" src="/images/stocklumo-mark.svg" width="38" height="38" alt="" />Stocklumo</a>
    @if (ViewData["HeaderSearch"] is true) { <partial name="_StockSearch" /> }
    <nav id="site-navigation" aria-label="Main navigation"><a href="/">Dashboard</a><a href="/markets">Markets</a><a href="/watchlist">Watchlist</a><a href="/news">News</a><a class="mobile-research-link" href="/screener">Stock screener</a><a class="mobile-research-link" href="/compare">Compare stocks</a><a class="mobile-research-link" href="/portfolio">Virtual portfolio</a><a class="mobile-research-link" href="/earnings">Earnings calendar</a></nav>
    <button id="theme" type="button">Dark mode</button>
    <button id="navigation-toggle" type="button" aria-expanded="false" aria-controls="site-navigation" hidden>Menu</button>
</header>
