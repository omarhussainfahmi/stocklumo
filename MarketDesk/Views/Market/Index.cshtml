@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model MarketDesk.Models.MarketSnapshot
@{ Layout = null; var symbol = ViewData["Symbol"] as string ?? ""; }
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Stocklumo: live stock tracking, watchlists and company information powered by Finnhub." />
    <title>Stocklumo - @(symbol.Length > 0 ? symbol : ViewData["Title"] ?? "Market watch")</title>
    <link asp-append-version="true" rel="icon" type="image/svg+xml" href="/images/stocklumo-icon.svg" />
    <link asp-append-version="true" rel="stylesheet" href="/css/market.css" />
    <script asp-append-version="true" src="/js/market.js" defer></script>
    <script asp-append-version="true" src="/js/research-math.js" defer></script>
    <script asp-append-version="true" src="/js/research.js" defer></script>
</head>
<body data-symbol="@symbol">
<a class="skip" href="#main">Skip to content</a>
<section class="ticker" aria-label="Live stock prices"><div id="ticker-stocks" class="ticker-stocks" tabindex="0" aria-label="Stock prices. Scroll horizontally for more stocks."><p>Loading live stock prices...</p></div></section>
<header class="header">
    <a class="brand" href="/" aria-label="Stocklumo home"><img asp-append-version="true" src="/images/stocklumo-mark.svg" width="38" height="38" alt="" />Stocklumo</a>
    <nav aria-label="Main navigation"><a href="/">Dashboard</a><a href="/markets">Markets</a><a href="/watchlist">Watchlist</a><a href="/news">News</a></nav>
    <button id="theme" type="button">Dark mode</button>
</header>
<div class="market-strip"><span id="market-status">US market status unavailable</span><span id="connection" role="status">SETUP</span><span>DATA / FINNHUB</span></div>
<main id="main" class="page">
    <nav class="research-nav" aria-label="Research tools"><a href="/screener">Stock screener</a><a href="/compare">Compare stocks</a><a href="/portfolio">Virtual portfolio</a><a href="/earnings">Earnings calendar</a></nav>
    <section id="research" class="section" hidden aria-labelledby="research-title"><p class="eyebrow">RESEARCH DESK</p><h1 id="research-title"></h1><p id="research-description" class="muted"></p><details class="data-notes"><summary>About this data</summary><p id="research-notes"></p></details><div id="research-controls" class="research-controls"></div><p id="research-status" role="status"></p><div id="research-results"></div></section>
    <section class="intro" aria-labelledby="page-title">
        <div class="intro-copy"><p class="eyebrow">YOUR MARKET DESK</p><h1 id="page-title">Follow the market.<br /><em>Find your perspective.</em></h1>
        <p id="intro-description" class="intro-description">Track prices. Explore companies. Follow what matters.</p>
        <div class="search"><label for="search">Find a stock</label><input id="search" type="search" maxlength="60" placeholder="Search a company or ticker symbol" autocomplete="off" aria-controls="search-results" /><p id="search-status" role="status"></p><ul id="search-results" aria-label="Search results" hidden></ul></div>
        <div id="intro-actions" class="intro-actions" hidden><a class="button-link primary" href="/markets">Explore markets <span aria-hidden="true">↗</span></a><a class="button-link" href="/watchlist">Your watchlist <span aria-hidden="true">→</span></a></div></div>
        <aside id="market-pulse" class="market-pulse" hidden aria-labelledby="pulse-title"><div class="panel-heading"><span class="eyebrow">MARKET SNAPSHOT</span><span class="caption">vs previous close</span></div><h2 id="pulse-title">Selected stocks. One view.</h2><div id="pulse-bars" class="pulse-bars"><p class="muted">Waiting for quotes.</p></div><p class="caption">Selected stocks, not a market index. Shared % scale; timestamps below.</p></aside>
    </section>
    <dl id="workspace-summary" class="workspace-summary" hidden><div><dt><svg class="summary-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 17V9m6 8V4m6 13v-6m6 6H1" /></svg>Stock coverage</dt><dd id="summary-universe">-</dd><span>US common stocks</span></div><div><dt><svg class="summary-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 5h18v14H3zM7 9h10M7 13h6" /></svg>Spotlight quotes</dt><dd id="summary-quotes">-</dd><span>Available / selected</span></div><div><dt><svg class="summary-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M2 12h5l3-8 4 16 3-8h5" /></svg>Live spotlight trades</dt><dd id="summary-live">-</dd><span>Fresh trades in this selection</span></div><div><dt><svg class="summary-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 21V5l8-3v19m0-14h10v14M6 8h2m-2 4h2m7-1h2m-2 4h2" /></svg>US exchanges</dt><dd id="summary-exchanges">-</dd><span>Nasdaq / NYSE / NYSE American</span></div><div><dt><svg class="summary-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 3h12v18l-6-4-6 4Z" /></svg>Saved stocks</dt><dd id="summary-watch">-</dd><a href="/watchlist">Open watchlist →</a></div><div><dt><svg class="summary-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 12a9 9 0 1 0 3-6M3 3v6h6m3-3v6l4 2" /></svg>Recently viewed</dt><dd id="summary-recent">-</dd><span>In this browser</span></div></dl>
    <details id="universe-coverage" class="data-notes" hidden><summary>Stock coverage &amp; updates</summary><p id="universe-note">Loading stock coverage.</p><p>USD common stocks on Nasdaq, NYSE and NYSE American. Excludes OTC, funds and other security types. Coverage refreshes every 24 hours; quote access varies. Market-wide advances and declines are unavailable.</p></details>
    <p id="notice" class="notice" role="status">@Model.Message</p>
    <section id="overview" class="section"><div class="section-title"><h2><span class="section-number" aria-hidden="true">01</span>Live stock spotlight</h2><span>DAILY US SELECTION</span></div><div id="spotlight" class="spotlight"><p class="muted">Loading stock prices...</p></div><p class="caption">Daily selection, not a ranking. Reload after 00:00 UTC for new picks. Check quote times.</p></section>
    <article id="stock-detail" hidden>
        <a class="back" href="/">← Dashboard</a>
        <div class="stock-summary"><div class="stock-header"><div><p id="symbol" class="eyebrow">@symbol</p><h1 id="company">Loading company…</h1><p id="exchange" class="muted"></p></div><button id="save-stock" type="button" disabled>Add to watchlist</button></div>
        <div class="quote-summary"><div class="price-line"><span id="price">-</span><span id="currency"></span></div><p id="change">Waiting for a quote</p><p id="data-age" class="caption">No price received</p></div></div>
        <section class="section"><div class="section-title"><h2>Price history</h2><div id="ranges" class="ranges"><button type="button" data-range="session" aria-pressed="true">Session</button><button type="button" data-range="1D" hidden>1D</button><button type="button" data-range="5D" hidden>5D</button><button type="button" data-range="1M" hidden>1M</button><button type="button" data-range="6M" hidden>6M</button><button type="button" data-range="1Y" hidden>1Y</button></div></div>
            <p id="chart-status" role="status" class="muted">Session observations start when a price arrives.</p>
            <div class="plot"><svg id="chart" viewBox="0 0 900 250" preserveAspectRatio="none" role="img" aria-label="Price history" tabindex="0"><path id="chart-line" d="" /><line id="cursor" x1="0" y1="15" x2="0" y2="220" hidden /></svg><div class="axis"><span id="chart-high">-</span><span id="chart-low">-</span></div></div>
            <div class="chart-foot"><span id="chart-start">-</span><output id="chart-value">Hover or use arrow keys for prices.</output><span id="chart-end">-</span></div>
            <p class="caption">Session: latest 120 observations from this visit. History depends on Finnhub access. Chart times are local.</p>
        </section>
        <dl id="stats" class="stats"></dl>
        <section class="section"><div class="section-title"><h2>About the company</h2></div><p id="company-status" class="muted">Loading company information…</p><dl id="company-info" class="company-info"></dl></section>
        <section id="company-news" class="section"><div class="section-title"><h2>Company news</h2></div><div id="stock-news"><p class="muted">Loading company news…</p></div></section>
    </article>
    <section id="watch-section" class="section"><div class="section-title"><h2><span class="section-number" aria-hidden="true">02</span>Your watchlist</h2><span id="watch-count">SAVED ON THIS DEVICE</span></div><p id="watch-empty" class="muted">No saved stocks. Search and add your first.</p><div class="table-wrap"><table id="watch-table" hidden><caption class="sr-only">Saved stocks. Prices and changes come from Finnhub.</caption><thead><tr><th>Company</th><th>Last price</th><th>Day change</th><th>Data age</th><th>Manage</th></tr></thead><tbody id="watch-rows"></tbody></table></div><p id="storage-status" role="status" class="caption">Saved in this browser.</p></section>
    <section id="recent-section" class="section"><div class="section-title"><h2><span class="section-number" aria-hidden="true">03</span>Recently viewed</h2></div><div id="recent" class="chips"></div></section>
    <section id="discover" class="section"><div class="section-title"><h2><span class="section-number" aria-hidden="true">04</span>Start exploring</h2><span>US COMPANIES · NOT RANKED</span></div><div id="explore-grid" class="chips explore-grid"><a href="/stock/AAPL"><strong>AAPL</strong><span>Apple</span></a><a href="/stock/MSFT"><strong>MSFT</strong><span>Microsoft</span></a><a href="/stock/NVDA"><strong>NVDA</strong><span>NVIDIA</span></a><a href="/stock/AMZN"><strong>AMZN</strong><span>Amazon</span></a><a href="/stock/GOOGL"><strong>GOOGL</strong><span>Alphabet</span></a><a href="/stock/META"><strong>META</strong><span>Meta</span></a><a href="/stock/TSLA"><strong>TSLA</strong><span>Tesla</span></a><a href="/stock/JPM"><strong>JPM</strong><span>JPMorgan Chase</span></a><a href="/stock/V"><strong>V</strong><span>Visa</span></a><a href="/stock/WMT"><strong>WMT</strong><span>Walmart</span></a><a href="/stock/XOM"><strong>XOM</strong><span>Exxon Mobil</span></a><a href="/stock/JNJ"><strong>JNJ</strong><span>Johnson & Johnson</span></a><a href="/stock/COST" class="explore-extra" hidden><strong>COST</strong><span>Costco</span></a><a href="/stock/NFLX" class="explore-extra" hidden><strong>NFLX</strong><span>Netflix</span></a><a href="/stock/AMD" class="explore-extra" hidden><strong>AMD</strong><span>AMD</span></a><a href="/stock/AVGO" class="explore-extra" hidden><strong>AVGO</strong><span>Broadcom</span></a><a href="/stock/KO" class="explore-extra" hidden><strong>KO</strong><span>Coca-Cola</span></a><a href="/stock/DIS" class="explore-extra" hidden><strong>DIS</strong><span>Disney</span></a><a href="/stock/HD" class="explore-extra" hidden><strong>HD</strong><span>Home Depot</span></a><a href="/stock/PG" class="explore-extra" hidden><strong>PG</strong><span>Procter & Gamble</span></a><a href="/stock/MA" class="explore-extra" hidden><strong>MA</strong><span>Mastercard</span></a><a href="/stock/BAC" class="explore-extra" hidden><strong>BAC</strong><span>Bank of America</span></a><a href="/stock/CRM" class="explore-extra" hidden><strong>CRM</strong><span>Salesforce</span></a><a href="/stock/ADBE" class="explore-extra" hidden><strong>ADBE</strong><span>Adobe</span></a></div><button id="more-stocks" type="button" aria-expanded="false" aria-controls="explore-grid">More stocks</button><p class="caption">Find more with stock search.</p></section>
    <section id="toolkit" class="section" hidden aria-labelledby="toolkit-title"><div class="section-title"><h2 id="toolkit-title"><span class="section-number" aria-hidden="true">05</span>From observation to research</h2><span>YOUR RESEARCH DESK</span></div><p class="muted">Explore, compare and track.</p><div class="tool-grid">
        <a href="/screener"><span class="eyebrow">FILTER / DISCOVER</span><h3>Stock screener <span aria-hidden="true">↗</span></h3><p>Filter 12 US companies by price and fundamentals.</p><span class="tool-action">Find your shortlist →</span></a>
        <a href="/compare"><span class="eyebrow">CONTEXT / COMPARE</span><h3>Compare stocks <span aria-hidden="true">↗</span></h3><p>Compare 2-5 companies and their performance.</p><span class="tool-action">Compare companies →</span></a>
        <a href="/portfolio"><span class="eyebrow">PRACTICE / TRACK</span><h3>Virtual portfolio <span aria-hidden="true">↗</span></h3><p>Track practice holdings. No real trades.</p><span class="tool-action">Track holdings →</span></a>
        <a href="/earnings"><span class="eyebrow">EVENTS / PLAN</span><h3>Earnings calendar <span aria-hidden="true">↗</span></h3><p>Upcoming dates, estimates and reported results.</p><span class="tool-action">Explore earnings →</span></a>
    </div></section>
    <section id="news-section" class="section"><div class="section-title"><h2><span class="section-number" aria-hidden="true">06</span>Market news</h2><span>PUBLISHER REPORTS</span></div><div id="news"><p class="muted">Loading market news…</p></div></section>
    <noscript><p class="notice">Enable JavaScript for live prices, search, watchlists and charts.</p></noscript>
</main>
<footer class="footer">
    <div class="footer-main">
        <div class="footer-about"><a class="brand" href="/"><img asp-append-version="true" src="/images/stocklumo-mark.svg" width="32" height="32" alt="" />Stocklumo</a><p>Your personal market desk. Built by Omar Hussain Fahmi.</p></div>
        <nav aria-label="Footer navigation"><h2>Explore</h2><a href="/">Dashboard</a><a href="/markets">Markets</a><a href="/watchlist">Watchlist</a><a href="/news">News</a></nav>
        <div class="footer-contact"><h2>Get in touch</h2><a href="mailto:omarhussainfahmi@hotmail.com">omarhussainfahmi@hotmail.com</a><a class="contact-button" href="https://www.linkedin.com/in/omar-hussain-fahmi-830b62256" target="_blank" rel="noopener noreferrer">LinkedIn ↗</a></div>
    </div>
    <div class="footer-notes"><p>Market data by <a href="https://finnhub.io/" target="_blank" rel="noopener noreferrer">Finnhub ↗</a>. Coverage and delays vary. For information only, not investment advice.</p><p>Watchlist, recent stocks and settings stay in this browser.</p></div>
    <div class="footer-bottom"><span>© @DateTime.UtcNow.Year Stocklumo</span><a href="#main">Back to top ↑</a></div>
</footer>
</body>
</html>


